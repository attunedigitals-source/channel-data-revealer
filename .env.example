# Server-side only. Do NOT prefix these with VITE_ - Vite inlines any
# VITE_-prefixed variable into the client-side JS bundle, which would leak
# these keys to anyone who opens devtools on the deployed site.
#
# All of these are optional server-wide defaults. Without them, each user
# can paste their own key into the app's API Settings modal instead - that
# key is only ever sent to your own server functions, never to the browser.

# YouTube Data API v3 key (https://console.cloud.google.com/apis/credentials)
YOUTUBE_API_KEY=

# One AI key is enough. Gemini keys (starting "AIza") are auto-detected and
# also used for grounded (real web search) fact verification.
GEMINI_API_KEY=
# OPENAI_API_KEY=

# Optional: override the default model names without touching code.
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_SEARCH_MODEL=gpt-4o-mini-search-preview
